# Copy to .env, fill in, then: node --env-file=.env src/bot.js
# Only DISCORD_TOKEN is needed; everything else is off when unset. Never commit .env.

# Your own bot's token (Discord Developer Portal → your app → Bot → Reset Token).
# Turn on the Server Members and Message Content intents there too.
DISCORD_TOKEN=

# Your test server's ID (Developer Mode on → right-click the server → Copy Server ID), and your own user ID:
# Kira treats that user as the owner (Ludovic's powers on Horizon's server).
GUILD_ID=
KIRA_OWNER_ID=

# Where Kira keeps its state (defaults to data/state.json, ignored by git).
# KIRA_STATE=data/state.json

# Optional: GitHub reads with your own token (fine-grained, public repositories read-only). Without it, Kira reads
# GitHub anonymously (60 requests an hour) and files no issues.
# GITHUB_TOKEN=
# KIRA_GITHUB_DRY_RUN=1

# Optional: AI answers (costs money on your Anthropic account; capped by KIRA_AI_DAILY_USD).
# KIRA_AI=1
# ANTHROPIC_API_KEY=
# KIRA_AI_DAILY_USD=1

# Optional: the HTTP server (MCP work board, /health). Unset = no HTTP server.
# KIRA_HTTP_PORT=8787
